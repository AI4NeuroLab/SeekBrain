{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": ["src/core/**/*.ts", "src/workflows/**/*.ts", "src/extension/**/*.ts", "tests/unit/**/*.ts"],
  "exclude": ["deprecated", "node_modules"]
}
