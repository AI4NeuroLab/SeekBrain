{
  "name": "seekbrain",
  "version": "0.1.4",
  "type": "module",
  "description": "SeekBrain scientific research agent",
  "license": "MIT",
  "bin": {
    "seekbrain": "./bin/seekbrain.mjs",
    "seekbrain-pdf": "./bin/seekbrain-pdf.mjs",
    "seekbrain-014": "./bin/seekbrain.mjs"
  },
  "keywords": [
    "scientific-research",
    "pi-extension",
    "agent-workflow"
  ],
  "files": [
    "bin",
    "assets",
    "examples",
    "src",
    "prompts",
    "config",
    "skills",
    "recipes",
    "scripts/build-recipe-index.mjs",
    "scripts/doctor.mjs",
    "scripts/install.sh",
    "scripts/install.ps1",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "DEVELOPMENT-014.md",
    "web/.next-release",
    "web/public",
    "web/package.json",
    "web/next.config.ts",
    "web/lib/gfm-autolink-email-loader.cjs",
    "scripts/build-web.mjs",
    "web/LICENSE",
    "web/upstream.json",
    "web/bin/prepare-terminal.js",
    "docs/windows.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "piConfig": {
    "name": "seekbrain",
    "configDir": ".pi"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "recipes:index": "node scripts/build-recipe-index.mjs",
    "test:rag-repositories": "jiti scripts/test-rag-repository-papers.ts",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "vitest run",
    "test:contract": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/package-e2e.mjs",
    "test": "npm run test:unit && npm run test:contract",
    "audit:opensource": "node scripts/open-source-audit.mjs",
    "pack:check": "node scripts/pack-dry-run.mjs",
    "tools:bundle": "node scripts/bundle-tools.mjs",
    "tools:pack": "node scripts/pack-tool-packages.mjs",
    "web:install": "npm --prefix web ci",
    "web:dev": "node bin/seekbrain.mjs web --dev",
    "web:build": "node scripts/build-web.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "diff": "8.0.4",
    "jiti": "2.7.0",
    "marked": "16.4.2",
    "pdfkit": "0.17.2",
    "pi-web-access": "0.42.0",
    "typebox": "1.1.24",
    "yaml": "2.9.0",
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-codemode": "1.2.0",
    "@earendil-works/pi-mcp": "1.2.0",
    "@earendil-works/pi-telemetry": "1.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "js-yaml": "^5.2.3",
    "next": "16.3.8",
    "node-pty": "1.2.0-beta.15",
    "proper-lockfile": "4.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "semver": "7.8.5",
    "undici": "8.11.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "optionalDependencies": {
    "seekbrain-tools-linux-x64": "0.1.0",
    "seekbrain-tools-linux-arm64": "0.1.0",
    "seekbrain-tools-darwin-x64": "0.1.0",
    "seekbrain-tools-darwin-arm64": "0.1.0",
    "seekbrain-tools-win32-x64": "0.1.0"
  }
}
