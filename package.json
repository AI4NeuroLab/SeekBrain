{
  "name": "seekbrain",
  "version": "0.1.1",
  "type": "module",
  "description": "SeekBrain scientific research agent",
  "license": "MIT",
  "bin": {
    "seekbrain": "./bin/seekbrain.mjs"
  },
  "keywords": [
    "scientific-research",
    "pi-extension",
    "agent-workflow"
  ],
  "files": [
    "bin",
    "src",
    "prompts",
    "config",
    "library/skills/trajectory",
    ".env.example",
    "scripts/doctor.mjs",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "piConfig": {
    "name": "seekbrain",
    "configDir": ".pi"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "typecheck": "tsc --project tsconfig.json",
    "test:unit": "vitest run",
    "test:contract": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/package-e2e.mjs",
    "test": "npm run test:unit && npm run test:contract",
    "audit:opensource": "node scripts/open-source-audit.mjs",
    "pack:check": "npm_config_cache=/tmp/seekbrain-npm-cache npm pack --dry-run --json | node scripts/pack-check.mjs"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.10",
    "@earendil-works/pi-tui": "0.80.10",
    "diff": "8.0.4",
    "typebox": "1.1.24",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
