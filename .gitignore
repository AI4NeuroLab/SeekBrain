# ── Dependencies / local toolchains (large, machine-specific) ──────────────
# .tools/ = project-local Node v24 + pi install (~2.4G); library/ ~6.4G
node_modules/
.tools/
# Keep the bundled trajectory seed versioned while ignoring the rest of the
# multi-gigabyte local library tree.
library/*
!library/skills/
library/skills/*
!library/skills/trajectory/
!library/skills/trajectory/**
vendor/
.internal/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.pyc

# ── Editor / OS ──────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.swo
*.log

# ── API keys / secrets — never commit real credentials ───────────────────────
# NOTE: .env.example and .env.sample are kept (placeholders only, safe templates)
.env
.env.bak
.env.bak.*
.env.local
.env.*.local

# ── Agent tool configs (machine/user-specific) ───────────────────────────────
.claude/
.codex/
.agents/

# ── pi runtime state (keep shared config, ignore ephemeral) ──────────────────
.pi/agent/
.pi/agent-sessions/
.pi-subagents/
.pi/agent/auth.json
.pi/neuroscientist-level1/tmp/
.pi/neuroscientist-level1/run_index.json
.pi/neuroscientist-level1/current_run.json
.pi/neuroscientist-level2/tmp/
.pi/neuroscientist-level2/run_index.json

# ── Runtime output / scratch ─────────────────────────────────────────────────
.playwright-cli/
tmp/
results/
evaluate/score/

# ── Root-level markdown docs (all excluded; subdirectory .md unaffected) ──────
/*.md
!/README.md
!/TODO.md
!/CONTRIBUTING.md
!/SECURITY.md
!/THIRD_PARTY_NOTICES.md
.pi/agent/sessions/
.pi/seekbrain/

# Local CI draft. Publishing files under .github/workflows requires a GitHub
# credential with the workflow scope.
.github/workflows/
