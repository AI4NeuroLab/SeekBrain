# Source file for ./scripts/setup_api.sh and ./pi_run_seekbrain.sh.
# Pi does not read this file automatically.
# Copy to .env, fill at least one API key, then run ./scripts/setup_api.sh.

# Official Anthropic API, or an Anthropic-compatible relay if BASE_URL is not
# https://api.anthropic.com. Leave BASE_URL empty for the official endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# Official OpenAI API, or an OpenAI-compatible relay if BASE_URL is not
# https://api.openai.com/v1. Leave BASE_URL empty for the official endpoint.
# Vendored targeted-skill Python modules also use these variables internally.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Literature providers. Setup normally stores these in the protected SeekBrain
# credential store; environment variables take precedence for deployments.
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
NCBI_EMAIL=
NCBI_TOOL=seekbrain

# Optional persistent literature-response cache path. The default is
# ~/.cache/seekbrain/literature-cache.json.
SEEKBRAIN_LITERATURE_CACHE=
