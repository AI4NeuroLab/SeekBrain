# Source file for ./deploy.sh. Pi does not read this file automatically.
# Run ./deploy.sh manually after editing these values; it updates
# .pi/agent/models.json and .pi/agent/auth.json.

# At least one provider must be configured. Base URLs are optional; defaults are:
#   ANTHROPIC_BASE_URL=https://api.anthropic.com
#   OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

OPENAI_API_KEY=
OPENAI_BASE_URL=

# Vendored legacy targeted-skill code also uses OPENAI_API_KEY/OPENAI_BASE_URL
# internally through ChatOpenAI.
